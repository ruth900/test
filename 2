const RAWC=$('#cfg').textContent;let CFG=JSON.parse(RAWC),L=CFG.flatMap(s=>s.lines);const KP=['1.1','1.1A','12.1','5.1','4.1A','1.6'];
let S=JSON.parse(RAW),canEdit=false,art=null;
const A=k=>S.adds[k]||[0,'',0];
function totals(){const t={};S.rows.forEach(r=>{for(const k in r.v)t[k]=(t[k]||0)+r.v[k]});return t}
function calc(l,t){const a=A(l.k),b=a[2]?0:l.codes.reduce((s,c)=>s+(t[c]||0),0);return{b,a:a[0],t:b+a[0],o:a[2]}}
function det(l,t){const a=A(l.k),p=[];if(!a[2])S.rows.forEach(r=>l.codes.forEach(c=>{if(r.v[c])p.push([r.o,c,r.v[c]])}));p.sort((x,y)=>y[2]-x[2]);
return(a[2]?'<p class=nt>Manual figure carried over from the source sheet.</p>':p.length?'<ul>'+p.map(x=>`<li><span>${esc(x[0])}</span><i>${x[1]}</i><b>${fmt(x[2])}</b></li>`).join('')+'</ul>':'<p class=nt>No submissions reported yet.</p>')+(a[1]?`<p class=nt>Additions: ${esc(a[1])}</p>`:'')}
function row(l,t){const c=calc(l,t);return`<tr class=m data-k="${esc(l.k)}"><td class=ti><b class=tn>${fmt(c.t)}</b><span class=tl>${esc(l.l)}<small>${esc(l.c)}${l.codes.length?'':' · manual entry'}${canEdit&&!c.t?' · no data yet':''}</small></span><td class="n sm">${c.o?'–':fmt(c.b)}<td class="n sm ad">${canEdit?`<input class=a type=number step=any value="${c.a}" data-k="${esc(l.k)}">`:c.a?'+'+fmt(c.a):'–'}${canEdit?'<td>'+l.codes.map((x,i)=>`<span class="cd${i?' x':''}">${x}</span>`).join(''):''}</tr><tr class=d hidden><td colspan=4>${det(l,t)}</tr>`}
function render(){const t=totals(),q=$('#q').value.toLowerCase();$('#per').textContent=S.period+' · '+S.rows.length+' submissions';
$('#kp').innerHTML=KP.map(k=>{const l=L.find(x=>x.k==k);return l?`<div class=k><b>${fmt(calc(l,t).t)}</b><span>${esc(l.l).replace(/\.$/,'')}</span></div>`:''}).join('');
$('#sec').innerHTML=CFG.map(s=>{const ls=s.lines.filter(l=>(canEdit||calc(l,t).t!==0)&&(!q||(l.l+' '+l.c+' '+l.codes.join(' ')).toLowerCase().includes(q)));return ls.length?`<section><h2>${esc(s.title)}</h2><div class=w><table><tr><th>Impact<th class=n>Reported<th class=n>+ Additions${canEdit?'<th>Fields combined':''}</tr>${ls.map(l=>row(l,t)).join('')}</table></div></section>`:''}).join('')}
$('#sec').addEventListener('click',e=>{if(e.target.closest('input'))return;const r=e.target.closest('tr.m');if(r)r.nextElementSibling.hidden=!r.nextElementSibling.hidden});
$('#sec').addEventListener('change',e=>{const k=e.target.dataset.k;if(!k)return;const a=A(k);S.adds[k]=[+e.target.value||0,a[1],a[2]];dirty('Additions edited.')});
$('#q').addEventListener('input',render);
function dirty(m){$('#pb').disabled=false;$('#msg').textContent=m+' Not yet published; viewers still see the previous version.';render()}
const code=s=>{const m=/(\d+\.\d+[A-Z]?)\s+Project Result/.exec(s||'');return m&&m[1]},num=x=>typeof x=='number'?x:typeof x=='string'&&/^\s*-?\d+(\.\d+)?\s*$/.test(x)?+x:null;
function parse(ws,name){const R=XLSX.utils.decode_range(ws['!ref']),E=XLSX.utils.encode_cell,v=(r,c)=>{const x=ws[E({r,c})];return x?x.v:null};
let per=name;for(let c=0;c<=R.e.c;c++){const m=/Date Range:\s*(.+)/.exec(v(0,c)||'');if(m)per=m[1]}
const left=[];for(let r=2;r<=R.e.r;r++){const o=v(r,0);if(!o)continue;const w={};for(let c=4;c<=R.e.c;c++){const k=code(v(1,c)),n=num(v(r,c));if(k&&n!=null)w[k]=(w[k]||0)+n}if(Object.keys(w).length)left.push({o:String(o).trim(),v:w})}
let hr=-1,hc=-1;for(let r=0;r<6&&hr<0;r++)for(let c=0;c<=R.e.c;c++)if(v(r,c)=='CATEGORY'){hr=r;hc=c;break}
let gc=-1;if(hr>=0)for(let c=hc+2;c<=R.e.c;c++)if(String(v(hr,c)).startsWith('SUMMARY:')){gc=c;break}
const sum=[],adds={};let cfg=null;
if(gc>0){const cols=[];for(let c=hc+2;c<gc;c++)cols.push(c);cols.forEach(c=>sum.push({o:String(v(hr,c)).trim(),v:{}}));cfg=[];const seen={},S=x=>String(x==null?'':x).trim(),tc=s=>s.replace(/[\[\]]/g,'').toLowerCase().replace(/\b\w/g,x=>x.toUpperCase()).trim(),lab=t=>{t=t.replace(/TRANING/g,'training').replace(/SERVIED/g,'served').replace(/FAMILES/g,'families').replace(/CHILDRENS/g,'children’s').replace(/BENEFITTED/g,'benefited').toLowerCase();['Gospel','Yeshua','Lord','Bibles','Israelis','Israel','FIRM','Jewish','Messianic'].forEach(p=>t=t.replace(new RegExp('\\b'+p+'\\b','gi'),p));return t.replace(/firm-supported/g,'FIRM-supported').replace(/\.$/,'')+'.'};let sec=null,post=false;
for(let r=hr+1;r<=R.e.r;r++){const ee=S(v(r,hc)),f=v(r,hc+1),gd=S(v(r,gc+1)),ge=S(v(r,gc+2)),nt=S(v(r,gc+3)),G=ws[E({r,c:gc})],ec=code(f);
if(/^SPECIAL NOTES/i.test(gd)){post=true;continue}
if(!gd&&!ec){if(ee&&!f&&!G&&!ge&&!post){sec={title:ee.replace(/:$/,''),lines:[]};cfg.push(sec)}continue}
if(post)sec=cfg.find(s=>/^Empowering/.test(s.title))||sec;if(!sec)continue;
const fl=ge&&ge[0]!='['?ge.split(',').map(x=>x.trim()).filter(Boolean):ec?[ec]:[];let k=ec||fl[0]||'m|'+gd.toLowerCase().slice(0,30);seen[k]=(seen[k]||0)+1;if(seen[k]>1)k+='#'+seen[k];
sec.lines.push({k,l:lab(gd),c:tc(ee),codes:fl});
if(ec&&!k.includes('#'))cols.forEach((c,i)=>{const n=num(v(r,c));if(n!=null)sum[i].v[ec]=(sum[i].v[ec]||0)+n});
if(G){if(G.f==null&&typeof G.v=='number')adds[k]=[G.v,nt,1];else if(G.f){const t=G.f.replace(/SUM\([^)]*\)/g,'').replace(/GC\d+/g,'');const a=[...t.matchAll(/\+\s*(\d+(?:\.\d+)?)/g)].reduce((s,m)=>s+ +m[1],0);if(a||nt)adds[k]=[a,nt,0]}}}}
const sr=sum.filter(x=>Object.keys(x.v).length),useS=sr.length>=left.length;
return{period:per,rows:useS?sr:left,adds:useS?adds:{},cfg:useS?cfg:null,src:useS?'summary columns':'Submissions rows',n:[sr.length,left.length]}}
$('#f').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;try{const wb=XLSX.read(await f.arrayBuffer(),{type:'array'}),r=parse(wb.Sheets[wb.SheetNames[0]],f.name.replace(/\.\w+$/,''));
if(!r.rows.length)throw Error('no submissions found');S={period:r.period,rows:r.rows,adds:r.adds};const ch=r.cfg?r.cfg.flatMap(s=>s.lines).filter(l=>{const o=L.find(x=>x.k==l.k);return !o||o.codes.join()!=l.codes.join()||o.l!=l.l}).map(l=>l.l):[];if(r.cfg&&r.cfg.length){CFG=r.cfg;L=CFG.flatMap(s=>s.lines)}
dirty(`Read ${r.rows.length} submissions from the ${r.src} (summary columns: ${r.n[0]}, Submissions rows: ${r.n[1]}); ${Object.keys(r.adds).length} additions picked up. ${ch.length?'Field mapping changed for '+ch.length+' metric(s) (shown below in Fields combined): '+ch.slice(0,4).join('; ')+(ch.length>4?'…':''):'Field mapping unchanged.'}`)}catch(x){$('#msg').textContent='Could not read that file: '+x.message}});
$('#pb').addEventListener('click',async()=>{$('#pb').disabled=true;try{await art.publish(SRC.split(RAW).join(JSON.stringify(S).replace(/</g,'\\u003c')).split(RAWC).join(JSON.stringify(CFG).replace(/</g,'\\u003c')))}catch(x){$('#msg').textContent='Publish failed ('+(x.code||x.message)+').';$('#pb').disabled=false}});
render();
(async()=>{if(!window.claude)return;try{const u=await claude.use('user');art=await claude.use('artifact');if(u&&u.canEdit()&&art){canEdit=true;$('#ed').hidden=false;render()}}catch(e){}})();
</script></body></html>
